---
import type { ChapterId } from "@/content.config";
import { CHAPTERS } from "@/content.config";

type Props = {
	id: ChapterId;
	/** 1-based chapter number. */
	number: number;
};

const { id, number } = Astro.props;
const { kanji, target, goal, title } = CHAPTERS[id];
---

<header class="chapter-card">
	<div class="wrap inner">
		<div class="text">
			<p class="kicker label">Chapter {number}</p>
			<h2 id={`${id}-heading`} class="title">
				{title}
			</h2>
			<dl class="target">
				<dt>Target</dt>
				<dd>{target}</dd>
				<dt>Goal</dt>
				<dd>{goal}</dd>
			</dl>
		</div>

		<p class="kanji" lang="ja">
			{kanji}
		</p>
	</div>
</header>

<style>
	.chapter-card {
		background: var(--surface-dark);
		color: var(--color-paper);
		overflow: hidden;
	}

	/* Text on the left, the chapter number in a vertical column on the right,
	   the way a title card is lettered in Japanese. */
	.inner {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: var(--space-l) var(--space-m);
		padding-block: var(--space-2xl);
	}

	.text {
		display: grid;
		gap: var(--space-xs);
		align-content: start;
	}

	.kicker,
	dt {
		color: var(--color-paper-muted);
	}

	.title {
		font-size: var(--step-3);
	}

	/* Two labelled rows: the name on the death list, then the number that kills it. */
	.target {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-2xs) var(--space-m);
		margin-block-start: var(--space-xs);
	}

	dd {
		margin: 0;
		color: var(--color-paper);
	}

	.kanji {
		writing-mode: vertical-rl;
		font-size: var(--step-2);
		line-height: 1;
		letter-spacing: 0.3em;
		color: var(--color-red-bright);
	}

	/* Held back for the motion script's entrance, so a card already on screen
	   does not flash before it rises. Never without JavaScript, never under
	   reduced motion, and released by `is-still` if the script fails to load. */
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		:global(html:not(.is-still)) :is(.kicker, .title, .target, .kanji) {
			visibility: hidden;
		}
	}
</style>
