---
import { getCollection } from "astro:content";

import ChapterCard from "@/components/ChapterCard.astro";
import DeathList from "@/components/DeathList.astro";
import PerfCard from "@/components/PerfCard.astro";
import { CHAPTER_IDS, pageOrder } from "@/taxonomy";
import BaseLayout from "@/layouts/BaseLayout.astro";

const entries = pageOrder(await getCollection("perf"));

const chapters = CHAPTER_IDS.map((id) => ({
	id,
	entries: entries.filter((entry) => entry.data.chapter === id),
})).filter((chapter) => chapter.entries.length > 0);

// Cards are numbered in the order they appear, which is by chapter first.
const reading = chapters.flatMap((chapter) => chapter.entries);
---

<BaseLayout
	title="Perf · where the milliseconds go"
	description="Slow code, the fix, and why, filed under the five Web Vitals in the order a page load reaches them: TTFB, FCP, LCP, CLS and INP."
>
	<header
		class="hero wrap"
		slot="header"
	>
		<div class="intro">
			<p
				class="motto"
				lang="ja"
			>
				寸陰を惜しむ
			</p>
			<p class="meta label">Frontend performance cheatsheet · Vol. 1</p>
			<h1 class="hero-title">
				PERF
				<span
					class="sun"
					aria-hidden="true"
				></span>
			</h1>
			<p class="lede">
				Where the milliseconds go, what spends them, and the line that wins them back.
			</p>
			<p class="meta gloss">
				<span lang="ja">寸陰を惜しむ</span> (sun’in o oshimu) is a Japanese saying: don’t
				waste a single moment.
			</p>
		</div>
		<DeathList />
	</header>

	{chapters.map(({ id, entries: items }, index) => (
		<section
			id={id}
			class="chapter"
			data-chapter={id}
			aria-labelledby={`${id}-heading`}
		>
			<ChapterCard
				id={id}
				number={index + 1}
			/>
			<div class="wrap">
				{items.map((entry) => (
					<PerfCard
						entry={entry}
						index={reading.indexOf(entry) + 1}
					/>
				))}
			</div>
		</section>
	))}

	<footer
		class="footer wrap"
		slot="footer"
	>
		<p
			class="end"
			lang="ja"
			aria-hidden="true"
		>
			終
		</p>
		<p>
			The box in the corner is this page measuring itself — no framework, the fonts
			self-hosted, GSAP loaded after the content, every tween on transform and opacity.
		</p>
		<p>
			<a href="https://dragunov.dev">Artem Dragunov</a> ·{" "}
			<a href="https://github.com/dragunovartem99/perf">source</a> ·{" "}
			<a href="https://dragunovartem99.github.io/vulns">Vol. 2: vulns</a>
		</p>
	</footer>
</BaseLayout>

<style>
	.hero {
		display: grid;
		gap: var(--space-xl);
		padding-block: var(--space-xl) var(--space-2xl);
	}

	@media (min-width: 60rem) {
		.hero {
			grid-template-columns: 1fr 20rem;
			align-items: end;
		}
	}

	/* The motto runs down the left edge in a column of its own, as it would on
	   a hanging scroll. */
	.intro {
		container-type: inline-size;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-m) var(--space-s);
	}

	@media (min-width: 48rem) {
		.intro {
			column-gap: var(--space-l);
		}
	}

	.intro > :not(.motto) {
		grid-column: 2;
	}

	.motto {
		grid-row: 1 / span 4;
		writing-mode: vertical-rl;
		font-size: var(--step-1);
		line-height: 1;
		letter-spacing: 0.5em;
	}

	.hero-title {
		/* Sized to its column, not the viewport: "PERF." is ~2.4em wide, so it
		   spans what the motto and the death list leave it at every width. */
		font-size: calc((100cqi - var(--space-xl)) / 2.42);
		white-space: nowrap;
		line-height: 0.8;
		letter-spacing: -0.05em;
		text-box: trim-both cap alphabetic;
	}

	/* The full stop is a red sun. */
	.sun {
		display: inline-block;
		width: 0.14em;
		aspect-ratio: 1;
		margin-inline-start: 0.08em;
		border-radius: 50%;
		background: var(--color-red);
	}

	.lede {
		max-width: 34ch;
		font-size: var(--step-1);
		color: var(--color-ink-muted);
	}

	.chapter .wrap {
		padding-block-end: var(--space-xl);
	}

	.footer {
		display: grid;
		gap: var(--space-s);
		padding-block: var(--space-xl) var(--space-2xl);
		border-top: 1px solid var(--color-ink-line);
		font-size: var(--step--1);
		color: var(--color-ink-muted);
	}

	/* 終, "the end", as the last frame of an old Japanese film prints it. */
	.end {
		justify-self: center;
		padding-block-end: var(--space-l);
		font-size: var(--step-3);
		line-height: 1;
		color: var(--color-ink);
	}
</style>
